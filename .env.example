# Postgres connection string (Neon, RDS, local — anything reachable).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://user:password@host:5432/dbname

# OpenAI API key — required by generate_stories and link_stories.
OPENAI_API_KEY=

# Object-store bucket — only needed when running a stage with --load-object-store.
# Currently S3-backed via boto3; standard AWS credential resolution applies
# (env vars, ~/.aws/credentials, instance role).
S3_BUCKET_NAME=
